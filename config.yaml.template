# audiobiblio configuration
# Copy to config.yaml and edit. All values can be overridden via env vars.

# Database URL (leave empty for default SQLite in platformdirs)
# db_url: "sqlite:///path/to/db.sqlite3"

# Library output directory (where finished audiobooks land)
library_dir: "/volume1/media/audiobooks"

# Temporary download directory
download_dir: "/volume1/media/_downloading"

# Scheduler intervals (minutes)
crawl_interval_minutes: 60
download_interval_minutes: 5

# Audiobookshelf integration
# abs_url: "http://audiobookshelf:13378"
# abs_api_key: "your-api-key-here"
# Env-var precedence (highest → lowest):
#   AUDIOBIBLIO_ABS_URL / AUDIOBIBLIO_ABS_API_KEY  (canonical, new)
#   config.yaml abs_url / abs_api_key
#   ABS_URL / ABS_API_KEY  (legacy — used by standalone scripts)

# JDownloader 2 (headless, same Docker network)
jd_host: "jdownloader"
jd_port: 3129

# Rate limiting for mujrozhlas.cz (requests per second)
rate_limit_rps: 0.5

# Trash retention (days before permanent deletion)
trash_retention_days: 30

# Import scanner inbox directories (list; also settable via AUDIOBIBLIO_INBOX_DIRS env, comma-separated)
# inbox_dirs:
#   - "/volume1/media/_inbox"
#   - "/volume1/media/_unsorted"

# Live recorder: broadcast-only slots (no on-demand audio) recorded from the stream
# live_recorder_enabled: true            # env AUDIOBIBLIO_LIVE_RECORDER=off disables
# live_stations: ["d-dur", "vltava", "plus"]   # env AUDIOBIBLIO_LIVE_STATIONS, comma-separated
# live_lookahead_days: 7
# live_music_dir: "/media/music/rozhlas"  # music stations (D-dur); spoken word goes to library_dir
# live_work_dir: ""                       # segments while recording; default <download_dir>/_live
